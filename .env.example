# Copy this file to .env and replace every placeholder before deployment.

# ─── Backend runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
ADMIN_PORT=3002
ADMIN_API_PREFIX=api/v1/admin
DB_LOGGING=false
USER_JWT_EXPIRES_IN=30d
ADMIN_JWT_EXPIRES_IN=8h

# ─── Supabase PostgreSQL ──────────────────────────────────────
# Dashboard → Connect → use the Session pooler URI for persistent Node.js APIs.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres
DB_SSL=true

# ─── Cloudflare R2 ────────────────────────────────────────────
# Create an R2 API token with Object Read & Write access for this bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=uniform-store
# Use an R2 custom domain (recommended) or the public r2.dev URL.
R2_PUBLIC_URL=https://assets.yourdomain.com

# ─── Auth and application ─────────────────────────────────────
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
USER_JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
ADMIN_JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
DOMAIN=yourdomain.com
CORS_ORIGINS=https://admin.yourdomain.com

# ─── Rate limiting and cache ──────────────────────────────────
THROTTLE_TTL=1000
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
SEARCH_THROTTLE_LIMIT=30
CART_THROTTLE_LIMIT=20
CACHE_TTL_PRODUCT=300
CACHE_TTL_SEARCH=60
CACHE_TTL_COLLECTION=600
CACHE_TTL_ARTICLE=900
LOG_LEVEL=debug
